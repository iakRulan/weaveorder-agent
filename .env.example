# 书生大模型（Intern-S2），OpenAI 兼容接口
# 获取 Key: https://internlm.intern-ai.org.cn/api/tokens
# 注意：TokenPlan 的 OpenAI 兼容入口是 discovery-api，不是 chat.intern-ai
INTERN_API_KEY=
INTERN_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
INTERN_MODEL=intern-s2
INTERN_MAX_TOKENS=8192

# v0.3：轻量模型用于 Intake / Verifier / Memory 等结构化任务
INTERN_FAST_MODEL=qwen3.8-27b

# 可选：按角色覆盖模型（留空使用 INTERN_MODEL；填 fast 使用 INTERN_FAST_MODEL）
INTERN_PLANNER_MODEL=
INTERN_CRITIC_MODEL=
INTERN_REPLANNER_MODEL=
INTERN_NARRATOR_MODEL=
INTERN_INTAKE_MODEL=fast
INTERN_VERIFIER_MODEL=fast
INTERN_MEMORY_MODEL=fast

# 0=关闭思考（默认，快）；1=开启（慢但更强）
INTERN_THINKING=0
INTERN_TIMEOUT=180
WEAVE_APPROVAL_TIMEOUT=600
WEAVE_MAX_STEPS=10
WEAVE_MAX_REPLANS=2
WEAVE_TOOL_TIMEOUT=30
